# Template for secrets.yaml -- copy this file to secrets.yaml and fill in the
# values. secrets.yaml itself is excluded by .gitignore and must never be
# committed. Keep the real values in a password manager.
#
# If you run the generated standalone configs from the ESPHome dashboard, the
# same keys have to exist in /config/esphome/secrets.yaml on the Home
# Assistant host as well.

# 2.4 GHz network the ESP joins. ESP32 needs WPA2 with PMF (802.11w) disabled.
wifi_ssid: "your-ssid"
wifi_password: "your-wifi-password"

# Encryption key for the ESPHome native API to Home Assistant.
# Generate with:  openssl rand -base64 32
api_encryption_key: "..."

# Password for over-the-air updates.
ota_password: "..."
